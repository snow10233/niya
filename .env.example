# 複製成 .env 再填入設定。用 `uv run --env-file .env niya …` 載入。
# 模型：預設 claude:opus（Claude 訂閱，先執行 `niya login`）。也可以用 `niya model` 切換。
NIYA_PROVIDER=
NIYA_MODEL=
# Claude 訂閱：一般用 `niya login` 登入就好；沒有瀏覽器的機器可改用 `niya login --token` 產生的長效 token
CLAUDE_CODE_OAUTH_TOKEN=
# 設了就改用 Anthropic API 計費，不用訂閱額度
ANTHROPIC_API_KEY=
# OpenRouter：provider=openrouter 時用來對話；之後的記憶 embedding 也走它
OPENROUTER_API_KEY=
# 本機開發時把資料放在專案目錄；VPS 上預設是 /var/lib/niya
NIYA_HOME=.niya
# Discord：bot token，以及主人的使用者 ID（也可以寫在 niya.toml 的 [discord]）
DISCORD_TOKEN=
NIYA_DISCORD_OWNER_ID=
# 網路搜尋（擇一）：Tavily 同時提供搜尋和網頁擷取
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
